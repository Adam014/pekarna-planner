# Test defaults, committed (as Next.js does for `.env.test`). Only local
# databases from docker-compose.yml, no secrets. Tests never read .env.local;
# override a value in .env.test.local (gitignored) or in the shell.
#
# Create the databases once:
#   docker compose exec db createdb -U pekarna pekarna_test
#   docker compose exec db createdb -U pekarna pekarna_e2e

# `bun run test:db`: emptied by every run.
TEST_DATABASE_URL=postgres://pekarna:pekarna@localhost:5432/pekarna_test
# `bun run test:e2e`: emptied and seeded by every run.
E2E_DATABASE_URL=postgres://pekarna:pekarna@localhost:5432/pekarna_e2e
