# Copy to .env.local. Local Postgres from docker-compose.yml:
DATABASE_URL=postgres://pekarna:pekarna@localhost:5432/pekarna
# For `bun run test:db`: a separate local database, emptied by every run.
# Create it once: docker compose exec db createdb -U pekarna pekarna_test
TEST_DATABASE_URL=postgres://pekarna:pekarna@localhost:5432/pekarna_test
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Demo account passwords for `bun run db:seed`, at least 15 characters each
SEED_OWNER_PASSWORD=
SEED_STAFF_PASSWORD=
