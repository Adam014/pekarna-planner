    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
