{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run format:check)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run build)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git check-ignore *)"
    ],
    "ask": ["Bash(git add *)", "Bash(git commit *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(vercel deploy *)",
      "Bash(vercel --prod *)",
      "Bash(bunx vercel *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -x \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier || exit 0; jq -r '.tool_input.file_path // empty' | xargs -I{} \"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/prettier --write --ignore-unknown --log-level warn {}"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { test -f package.json || exit 0; } && bun run typecheck 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
